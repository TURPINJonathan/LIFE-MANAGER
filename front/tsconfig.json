{
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@components": ["./app/components/index.ts"],
      "@constants": ["./app/constants/index.ts"],
      "@hooks": ["./app/hooks/index.ts"],
      "@layouts": ["./app/layouts/index.ts"],
      "@pages": ["./app/pages/index.ts"],
      "@categories": ["./app/modules/categories/index.ts"],
      "@merchants": ["./app/modules/merchants/index.ts"],
      "@accounts": ["./app/modules/accounts/index.ts"],
      "@events": ["./app/modules/events/index.ts"],
      "@security": ["./app/security/index.ts"],
      "@services": ["./app/services/index.ts"],
      "@store": ["./app/store/index.ts"],
      "@app-types": ["./app/types/index.ts"],
      "@utils": ["./app/utils/index.ts"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
