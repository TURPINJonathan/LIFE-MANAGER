{
  "name": "life-manager-front",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 9200",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "npm run format && npm run lint:fix",
    "check": "npm run format:check && npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "ci": "npm run check && npm run typecheck && npm run test",
    "generate:icons": "node scripts/generate-icon-catalog.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "date-fns": "^4.1.0",
    "isbot": "^5.1.37",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.74.0",
    "react-router": "8.3.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
